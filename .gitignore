# Root gitignore for CP monorepo

# Composer dependencies
/vendor/
**/vendor/

# Node dependencies
/node_modules/
**/node_modules/

# Environment files
.env
.env.*

# Build and logs
/build/
/public/hot
/public/storage
/storage/*.key
/storage/debugbar
/storage/*.log
/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE + OS
/.idea/
.vscode/
.DS_Store
Thumbs.db

# Ignore nested Git metadata if any remains
**/.git
